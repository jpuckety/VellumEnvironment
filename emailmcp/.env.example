# EmailMCP Environment Configuration
# Copy to .env and fill values. Never commit real secrets.

# Server
EMAILMCP_LISTEN_ADDR=:8080

# IMAP pool tuning
EMAILMCP_IMAP_MAX_CONNS=4
EMAILMCP_IMAP_IDLE_TIMEOUT=5m

# SMTP
EMAILMCP_SMTP_TIMEOUT=30s

# Logging
EMAILMCP_LOG_LEVEL=info

# Required: Google OAuth. Per-user email account configuration (including
# IMAP/SMTP credentials) is stored directly in the EmailMCPUserConfigs DynamoDB
# table by this server — there is no separate Config API and no local database.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Required for HTTP mode: used by the MCP OAuth authorization-code proxy to Google.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public origin of this server (OAuth issuer + redirect base). Must match the
# authorized redirect URI in Google Cloud Console:
#   {PUBLIC_BASE_URL}/oauth/callback
PUBLIC_BASE_URL=https://emailmcp.ecg.co

APPLICATION_ID=default

# Optional: HTTPS OAuth redirect_uri allowlist (issue #3). Comma-separated
# hostnames, wildcards, or https URIs. Passed to EKS via deploy/eks/configmap.yaml.
#   blank / unset  → allowlist NOT enforced (any HTTPS redirect host accepted)
#   non-empty      → HTTPS redirects must match an entry
# Loopback HTTP (localhost/127.0.0.1) and custom schemes (cursor://) are always allowed.
# Examples:
#   OAUTH_REDIRECT_ALLOWLIST=app.example.com,*.corp.example.com
#   OAUTH_REDIRECT_ALLOWLIST=https://web.example.com/oauth/callback
OAUTH_REDIRECT_ALLOWLIST=


# Optional: DynamoDB table storing OAuth sessions (opaque access/refresh tokens)
# and registered clients. On EKS this is auto-resolved from the SSM parameter
# /emailmcp/session-table/name provisioned by the CDK stack, so you normally do
# NOT need to set it. When unset (and no SSM parameter), the server falls back to
# an in-memory store (sessions do not survive a restart or span replicas).
# EMAILMCP_SESSION_TABLE=

# Optional: DynamoDB table storing per-user email account configurations
# (IMAP/SMTP settings + credentials). On EKS this is auto-resolved from the SSM
# parameter /emailmcp/user-config-table/name provisioned by the CDK stack, so
# you normally do NOT need to set it. When unset (and no SSM parameter), the
# server falls back to an in-memory store (accounts do not survive a restart or
# span replicas).
# EMAILMCP_USER_CONFIG_TABLE=

# Cloud / EKS Mode
# AWS_REGION=us-east-1
#
# IRSA (required for the pod's direct DynamoDB/KMS access via the AWS SDK).
# Prefer EKS_OIDC_PROVIDER_ARN here (this file is gitignored). Without OIDC,
# `./run.sh infra-deploy` fails closed so the IRSA role is not deleted.
# Alternate local file: infrastructure/cdk.local.json (also gitignored).
# Do not put these ARNs in committed cdk.json — they identify account/cluster.
# EKS_OIDC_PROVIDER=https://oidc.eks.us-east-1.amazonaws.com/id/EXAMPLEDATA
# EKS_OIDC_PROVIDER_ARN=arn:aws:iam::123456789012:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/EXAMPLEDATA
# EKS_CLUSTER_NAME=my-cluster
# EKS_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/uuid
