# EmailMCP Environment Configuration
# Copy to .env and fill values. Never commit real secrets.

# REQUIRED: 32-byte key, base64 encoded. Generate with:
#   openssl rand -base64 32
EMAILMCP_MASTER_KEY=CHANGE_ME_TO_32_BYTE_BASE64_KEY

# Server
EMAILMCP_LISTEN_ADDR=:8080

# Database (SQLite file path)
EMAILMCP_DB_PATH=./emailmcp.db

# IMAP pool tuning
EMAILMCP_IMAP_MAX_CONNS=4
EMAILMCP_IMAP_IDLE_TIMEOUT=5m

# SMTP
EMAILMCP_SMTP_TIMEOUT=30s

# Logging
EMAILMCP_LOG_LEVEL=info

# Cloud Mode (required if using Cloud architecture)
# AWS_REGION=us-east-1
# EKS_OIDC_PROVIDER=oidc.eks.us-east-1.amazonaws.com/id/EXAMPLEDATA
# EKS_OIDC_PROVIDER_ARN=arn:aws:iam::123456789012:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/EXAMPLEDATA
# EKS_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/uuid
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CONFIG_API_URL=https://qfbbdrqtwwo6bdcyyel7ml2zzi0ipeuf.lambda-url.us-east-1.on.aws/
# APPLICATION_ID=default
